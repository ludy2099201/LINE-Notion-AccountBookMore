# ── LINE Messaging API ──
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# ── Notion API ──
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 「歸屬月份」欄位名稱（選填）。資料庫有這個欄位才會寫入
# NOTION_PERIOD_PROPERTY=歸屬月份

# ── Google Gemini API（含 Vision OCR）──
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
LLM_MODEL=models/gemini-2.5-flash
VISION_MODEL=models/gemini-2.5-flash

# ── 補習班設定 ──
SCHOOL_NAME=慕熙大世界補習班

# ── 應用程式 ──
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false
# 記帳日期使用的時區（相對 UTC 的小時數，台灣為 8）
APP_UTC_OFFSET_HOURS=8
